{
  "name": "multi-google-mcp",
  "version": "1.0.0",
  "description": "A Model Context Protocol server for Gmail, Calendar and Drive across multiple Google accounts, for Claude Code.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "multi-google-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "auth": "node dist/authorize.js"
  },
  "keywords": [
    "mcp",
    "gmail",
    "google-calendar",
    "google-drive",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "googleapis": "^173.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
